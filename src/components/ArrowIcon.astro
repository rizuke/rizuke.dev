---
type Direction = "right" | "left";

interface Props {
  direction?: Direction;
}

const { direction = "right" } = Astro.props;

type ArrowConfig = {
  position: string;
  size: string;
  poly: string;
};

const config: Record<Direction, ArrowConfig> = {
  right: {
    position: "right-2",
    size: "size-5",
    poly: "12 5 19 12 12 19",
  },
  left: {
    position: "left-2",
    size: "size-4",
    poly: "12 5 5 12 12 19",
  },
};

const { position, size, poly } = config[direction];
const lineClasses =
  direction === "right"
    ? "translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100"
    : "translate-x-2 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100";
const polyClasses =
  direction === "right"
    ? "-translate-x-1 group-hover:translate-x-0"
    : "translate-x-1 group-hover:translate-x-0";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={`absolute top-1/2 ${position} -translate-y-1/2 ${size} stroke-2 fill-none stroke-current`}
>
  <line
    x1="5"
    y1="12"
    x2="19"
    y2="12"
    class={`${lineClasses} transition-transform duration-300 ease-in-out`}
  />
  <polyline
    points={poly}
    class={`${polyClasses} transition-transform duration-300 ease-in-out`}
  />
</svg>