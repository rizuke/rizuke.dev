---
import { SITE } from "../consts";
---

<header>
  <div class="mx-auto max-w-screen-md px-5">
    <div class="flex justify-between items-center">
      <a href="/" class="inline-block">
        <img
          src="/rizuke-dev-logo.svg"
          alt={SITE.NAME}
          class="h-6 w-auto"
        />
      </a>
      <div class="flex items-center gap-3">
        <a
          href="/blog"
          class="text-sm text-white/60 hover:text-white transition-colors duration-300 ease-in-out"
        >
          blog
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    @apply fixed top-0 left-0 right-0 z-50 py-5;
    @apply bg-neutral-950/90 backdrop-blur-sm;
  }
</style>