---
import Container from "./Container.astro";
import { SITE } from "../consts";

const buildDate = new Date().toISOString().replace("T", " ").slice(0, 16) + " UTC";
---

<footer>
  <Container>
    <div class="text-center text-sm">
      <button
        type="button"
        aria-label={`${SITE.NAME} copyright. Built ${buildDate}`}
        class="group relative inline-block cursor-help focus:outline-none">
        &copy; {new Date().getFullYear()} {SITE.NAME}
        <span
          role="tooltip"
          class="pointer-events-none absolute bottom-full left-1/2 mb-2 w-max -translate-x-1/2 rounded-md bg-white px-2 py-1 text-xs font-medium text-neutral-900 shadow-lg opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100">
          Built {buildDate}
        </span>
      </button>
    </div>
  </Container>
</footer>
