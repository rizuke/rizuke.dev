{
  "name": "Astro Blog",
  "image": "node-pnpm:latest",
  "remoteUser": "node",
  "forwardPorts": [4321],
  "postCreateCommand": "pnpm install",
  "mounts": [
    "source=pnpm-store,target=/.pnpm-store,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode"]
    }
  },
  "containerEnv": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true"
  ]
}